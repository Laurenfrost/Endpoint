{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Endpoint",
  "version": "0.1.0",
  "identifier": "dev.endpoint.app",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Endpoint — 网文 txt → EPUB",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "icon": [],
    "resources": {
      "resources/fonts/*": "fonts/",
      "resources/themes/*": "themes/"
    }
  }
}
